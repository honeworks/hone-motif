{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "lines": {
   "minItems": 1,
   "maxItems": 600,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "end_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "text": {
      "type": "string",
      "maxLength": 90,
      "description": "the whole line"
     },
     "words": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "text": {
         "type": "string",
         "minLength": 1,
         "maxLength": 40
        },
        "start_ms": {
         "type": "integer",
         "minimum": 0,
         "maximum": 9007199254740991
        },
        "end_ms": {
         "type": "integer",
         "minimum": 0,
         "maximum": 9007199254740991
        }
       },
       "required": [
        "text",
        "start_ms",
        "end_ms"
       ]
      },
      "description": "every word of the line in reading order"
     }
    },
    "required": [
     "start_ms",
     "end_ms",
     "text",
     "words"
    ]
   },
   "description": "the timed lines, in milliseconds from the placement start"
  }
 },
 "required": [
  "lines"
 ],
 "additionalProperties": false
}
