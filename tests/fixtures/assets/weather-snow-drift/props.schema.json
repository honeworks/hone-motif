{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "intensity": {
   "default": 1,
   "description": "how much of the effect: fewer or more, fainter or stronger",
   "type": "number",
   "minimum": 0.25,
   "maximum": 1.5
  }
 },
 "additionalProperties": false
}
