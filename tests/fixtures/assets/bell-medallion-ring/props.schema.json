{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "label": {
   "default": "Turn on notifications",
   "type": "string",
   "maxLength": 28,
   "description": "the main line"
  },
  "sublabel": {
   "default": "",
   "type": "string",
   "maxLength": 36,
   "description": "a second line, often in a second language"
  },
  "corner": {
   "default": "top-right",
   "type": "string",
   "enum": [
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right"
   ]
  }
 },
 "additionalProperties": false
}
