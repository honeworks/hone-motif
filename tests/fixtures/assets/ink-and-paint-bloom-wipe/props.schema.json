{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "direction": {
   "default": "rtl",
   "description": "the way the blooms spread",
   "type": "string",
   "enum": [
    "ltr",
    "rtl"
   ]
  },
  "seed": {
   "default": 3,
   "description": "varies the shapes",
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  }
 },
 "additionalProperties": false
}
