{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "monogram": {
   "type": "string",
   "maxLength": 2,
   "description": "one or two letters inside the star"
  },
  "channelName": {
   "type": "string",
   "maxLength": 24,
   "description": "the channel name beside the star"
  },
  "corner": {
   "default": "bottom-right",
   "type": "string",
   "enum": [
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right"
   ]
  },
  "restOpacity": {
   "default": 0.6,
   "description": "opacity after it settles",
   "type": "number",
   "minimum": 0.2,
   "maximum": 1
  },
  "glintEverySec": {
   "default": 4,
   "description": "seconds between two glints",
   "type": "number",
   "minimum": 2,
   "maximum": 30
  },
  "brand": {
   "type": "object",
   "properties": {
    "bg": {
     "description": "the backdrop of scenes",
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "ink": {
     "description": "text on the backdrop",
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "inkSoft": {
     "description": "secondary text",
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "accent": {
     "description": "the main accent",
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "accent2": {
     "description": "a second accent",
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "muted": {
     "description": "quiet lines and labels",
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "fonts": {
     "type": "object",
     "properties": {
      "display": {
       "description": "big titles and headings",
       "type": "string",
       "minLength": 1,
       "maxLength": 60
      },
      "body": {
       "description": "labels, buttons and soft lines",
       "type": "string",
       "minLength": 1,
       "maxLength": 60
      },
      "rtl": {
       "description": "right-to-left text (Arabic script)",
       "type": "string",
       "minLength": 1,
       "maxLength": 60
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false,
   "description": "a channel's colours and fonts, laid over the theme (change 0003)"
  }
 },
 "required": [
  "monogram",
  "channelName"
 ],
 "additionalProperties": false
}
