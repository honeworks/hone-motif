{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "holdMs": {
   "default": 250,
   "description": "how long the frame stays fully dipped around the cut",
   "type": "integer",
   "minimum": 0,
   "maximum": 1000
  }
 },
 "additionalProperties": false
}
