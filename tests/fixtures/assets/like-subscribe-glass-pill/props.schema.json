{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "likeLabel": {
   "default": "Like",
   "type": "string",
   "maxLength": 12,
   "description": "the Like button"
  },
  "subscribeLabel": {
   "default": "Subscribe",
   "type": "string",
   "maxLength": 14,
   "description": "the Subscribe button"
  },
  "subscribedLabel": {
   "default": "Subscribed",
   "type": "string",
   "maxLength": 14,
   "description": "the button after the press"
  },
  "channelName": {
   "type": "string",
   "maxLength": 24,
   "description": "the channel name above the pill"
  },
  "corner": {
   "default": "bottom-left",
   "type": "string",
   "enum": [
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right"
   ]
  }
 },
 "required": [
  "channelName"
 ],
 "additionalProperties": false
}
