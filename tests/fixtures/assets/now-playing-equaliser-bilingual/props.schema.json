{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "kicker": {
   "default": "NOW PLAYING",
   "type": "string",
   "maxLength": 18,
   "description": "the small line above, e.g. NOW PLAYING"
  },
  "title": {
   "type": "string",
   "maxLength": 32,
   "description": "the song or video title"
  },
  "titleAlt": {
   "default": "",
   "type": "string",
   "maxLength": 32,
   "description": "the title in a second language, set beside it"
  },
  "artist": {
   "default": "",
   "type": "string",
   "maxLength": 48,
   "description": "the artist or credit line"
  }
 },
 "required": [
  "title"
 ],
 "additionalProperties": false
}
