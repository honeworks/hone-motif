{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "theme": {
   "default": "cinematic",
   "description": "the look (design §4.1)",
   "type": "string",
   "enum": [
    "cinematic",
    "dark",
    "documentary",
    "warm",
    "pop"
   ]
  },
  "accent": {
   "description": "replaces the theme's accent colour",
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "name": {
   "type": "string",
   "maxLength": 28,
   "description": "the name, on the first line"
  },
  "role": {
   "default": "",
   "type": "string",
   "maxLength": 40,
   "description": "the role or title under the name"
  },
  "corner": {
   "default": "bottom-left",
   "type": "string",
   "enum": [
    "top-left",
    "top-center",
    "top-right",
    "center-left",
    "center",
    "center-right",
    "bottom-left",
    "bottom-center",
    "bottom-right"
   ]
  }
 },
 "required": [
  "name"
 ],
 "additionalProperties": false
}
